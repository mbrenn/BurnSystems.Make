<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>bsmake</AssemblyName>
        
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>bsmake</ToolCommandName>   
        <PackageId>BurnSystems.Make.Exe</PackageId>
        <Version>1.0.5</Version>
        <Authors>Martin Brenn</Authors>
        <PackageOutputPath>./nupkg</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BurnSystems.Make\BurnSystems.Make.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="nupkg\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="nupkg\BurnSystems.Make.Exe.1.0.5.nupkg" />
    </ItemGroup>

</Project>
